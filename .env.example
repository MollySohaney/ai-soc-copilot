# Purpose: Document the environment variables supported by the application.
#
# Copying this file to .env gives you the default local demo: PostgreSQL only,
# fixture telemetry, and the deterministic offline AI provider. No Elastic
# cluster and no paid AI account are required or used.

APP_NAME=AI SOC Copilot
APP_ENV=development
# Read only by `python -m db.reset_demo`, which refuses to delete rows unless this
# is development, demo, test, or local. Falls back to APP_ENV when unset.
ENVIRONMENT=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8501
LOG_LEVEL=INFO
LOG_DIR=logs
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_TYPES=json,csv,txt
API_VERSION=v1
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:8501
POSTGRES_HOST=localhost
# docker-compose.yml publishes the container on this host port. If a system
# PostgreSQL already owns 5432, change this to a free port such as 5435 before
# running `docker compose up -d`; the application and Alembic both follow it.
POSTGRES_PORT=5432
POSTGRES_DB=ai_soc_copilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Leave ELASTIC_URL empty for the default demo. Ingestion then runs only through
# the deterministic in-memory fixture adapter.
ELASTIC_URL=
ELASTIC_INDEX_PATTERN=logs-*
ELASTIC_SOURCE_NAME=elastic-default
ELASTIC_API_KEY=
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
ELASTIC_REQUEST_TIMEOUT_SECONDS=10
ELASTIC_VERIFY_CERTS=true
MAX_INGESTION_SYNC_LIMIT=1000
INGESTION_RETRY_ATTEMPTS=3
INGESTION_RETRY_BACKOFF_SECONDS=0.5
# AI_ENABLED=false makes every AI action return "unavailable". The demo needs it
# true. The only implemented provider is "fake": a deterministic, offline,
# in-process responder used to exercise the prompt, context, schema-validation,
# and abuse-control layers. No network call is made and no API key is used.
# Setting AI_PROVIDER to a vendor name does not reach that vendor; it falls back
# to unavailable. See docs/ai-safety.md.
AI_ENABLED=true
AI_PROVIDER=fake
AI_MODEL=fake-model
# Not read by any implemented provider. Leave empty.
AI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=1000
AI_PROMPT_VERSION=v1
AI_RESPONSE_SCHEMA_VERSION=v1
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_ABSOLUTE_HOURS=8
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
API_MAX_BODY_BYTES=1048576
API_MAX_QUERY_WINDOW_DAYS=31
ABUSE_RATE_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=10
LOGIN_CONCURRENCY_LIMIT=2
AI_RATE_LIMIT=10
AI_CONCURRENCY_LIMIT=2
INGESTION_RATE_LIMIT=10
INGESTION_CONCURRENCY_LIMIT=1
DETECTION_RATE_LIMIT=20
DETECTION_CONCURRENCY_LIMIT=2
# Optional input for `python -m db.bootstrap_user`, `python -m scripts.smoke`, and
# `python -m scripts.demo_pipeline`; never commit a real value.
#
# The full demo narrative spans four permissions: mutate_investigations and
# request_ai (Analyst), manage_detections (Detection Engineer), and
# operate_integrations plus read_audit (Admin). Only Admin holds all of them, so
# the single-account demo path bootstraps an admin. See docs/permissions.md.
DEMO_USERNAME=demo-admin
DEMO_PASSWORD=
