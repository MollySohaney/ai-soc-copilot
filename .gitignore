# Purpose: Ignore local environment artifacts, caches, logs, and OS-generated files.

.DS_Store
.env
.env.local
.venv/
.agents/
.claude/*
!.claude/commands/
!.claude/commands/agents/
!.claude/commands/agents/git-setup.md
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
logs/*.log
streamlit.log
